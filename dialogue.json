    },
    {
        "speaker": "Brian",
        "text": "[happy] Maybe both.",
        "emotion": "happy"
    },
    {
        "speaker": "Tracy",
        "text": "[neutral] You know... creative people often work like that.",
        "emotion": "neutral"
    },
    {
        "speaker": "Brian",
