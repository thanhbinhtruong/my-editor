    },
    {
        "speaker": "Brian",
        "text": "[frustrated] Oh absolutely.",
        "emotion": "frustrated"
    },
    {
        "speaker": "Brian",
        "text": "[neutral] I once asked an AI to help build a small website.",
        "emotion": "neutral"
    },
    {
        "speaker": "Brian",
        "text": "[neutral] At first everything looked amazing.",
        "emotion": "neutral"
    },
    {
        "speaker": "Brian",
        "text": "[sad] Then suddenly... nothing worked.",
        "emotion": "sad"
    },
